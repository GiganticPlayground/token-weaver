# Token Weaver environment variables

# Server configuration
PORT=3000
NODE_ENV=development
# LOG_LEVEL=debug
# LOG_TYPE=pretty

# CORS configuration
# Leave unset to allow all origins.
# Use * to explicitly allow all origins.
# Example: http://localhost:3000,https://app.example.com
# CORS_ORIGINS=*

# Reverse proxy configuration
# Controls Express trust proxy behavior.
# Use false for direct connections, true to trust forwarded headers,
# or a number like 1 when exactly one proxy sits in front of the app.
# This matters for req.ip and IP-based rate limiting.
# TRUST_PROXY=false

# In-process auth rate limiting
# Disabled by default. Set to true to enable.
# RATE_LIMIT_ENABLED=false
# Maximum requests per window per client IP.
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000

# Token Weaver configuration
# TOKEN_WEAVER_CONFIG_PATH=config/token-weaver.yaml
# TOKEN_WEAVER_KID=token-weaver-key

# Strategy configuration secrets
# These are examples referenced by config/token-weaver.yaml.
TW_INBOUND_KEY=replace-with-inbound-api-key
STATIC_CLIENT_SECRET=replace-with-direct-strategy-secret
UPSTREAM_API_TOKEN=replace-with-upstream-bearer-token

# Signing key configuration
# Set exactly one of these for normal operation.
TOKEN_WEAVER_PRIVATE_KEY_PATH=./config/keys/private-key.pem
# TOKEN_WEAVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
