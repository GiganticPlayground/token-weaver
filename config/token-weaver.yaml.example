strategies:
  - name: device
    type: direct
    inbound_auth:
      type: api_key
      header: X-API-Key
      key: ${TW_INBOUND_KEY}
    credential_path: $.request.body.secret
    credentials:
      - secret: ${STATIC_CLIENT_SECRET}
        claims:
          sub: client-device-001
          scope:
            - general
          customClaim: example-value
    jwt:
      issuer: token-weaver
      ttl: 3600

  - name: player
    type: delegated
    inbound_auth:
      type: api_key
      header: X-API-Key
      key: ${TW_INBOUND_KEY}
    upstream:
      url: https://auth-service.example.com/v1/verify
      method: POST
      timeout_ms: 5000
      auth:
        type: bearer
        token: ${UPSTREAM_API_TOKEN}
      body_mapping:
        username: $.request.body.username
        password: $.request.body.password
    response_mapping:
      success_condition: $.status == 'ok'
      error_mappings:
        - condition: $.response.status == 403
          status: 403
          message: $.response.body.message
          code: FORBIDDEN
        - condition: $.response.status == 401
          status: 401
          message: Invalid credentials
        - condition: $.response.status == 404
          status: 404
          message: User Not found
        - status: 401
          message: $.response.body.error
      claims:
        sub: $.response.body.userId
        scope:
          - general
    # Claims a frontend must NOT read. Encrypted into a single opaque `enc` claim; only holders
    # of the shared secret (backend services) can decrypt it. Generate: openssl rand -base64 32
    encrypted_claims:
      secret: ${TW_ENC_SECRET}
      claim: enc
      claims:
        internalUserId: $.response.body.internalId
        entitlements: $.response.body.entitlements
    log:
      request_body: false
      response_body: false
      request_headers: false
    jwt:
      issuer: token-weaver
      ttl: 3600

  # HS256 strategy — for consumers that validate with shared secret (e.g. CloudFront Functions)
  - name: hmac-client
    type: direct
    jwt:
      algorithm: HS256
      secret: ${TW_HMAC_SECRET}
      issuer: token-weaver
      ttl: 3600
    credentials:
      - secret: ${TW_HMAC_CLIENT_SECRET}
        claims:
          sub: hmac-client
          scope: mobile

  # Token exchange: verify another issuer's JWT against their JWKS, then mint ours from its
  # claims. Keeps consumers on one issuer and one claim vocabulary while upstream IdPs vary.
  # - name: ipb
  #   type: jwt
  #   credential_path: $.request.headers.authorization   # default; 'Bearer ' tolerated
  #   verify:
  #     jwks_uri: https://idp.example.com/.well-known/jwks.json
  #     issuer: https://idp.example.com/
  #     audience: ipb
  #     requirements:
  #       - { type: scope, value: 'ipb:play' }
  #   claims:
  #     sub: $.request.jwt.sub          # the verified upstream payload lives at $.request.jwt
  #     routes:
  #       whitelist: ['ipb/v1/getPlayerState']
  #   # Optional: one endpoint, different claims per calling client. A matched entry is layered
  #   # over the base claims per top-level claim. An unknown identifier is refused (401) unless
  #   # require_known_client is false.
  #   client_id_path: $.request.body.clientId   # default
  #   # The identifier comes from the caller, so it is only as strong as its secrecy. Set
  #   # client_claim to a VERIFIED claim that must agree with it, and the upstream token decides
  #   # which clients a caller may present (mismatch = 403).
  #   client_claim: client_ids
  #   clients:
  #     - client_id: kiosk-a1b2
  #       claims:
  #         routes: { whitelist: ['ipb/v1/getPlayerState'] }
  #     - client_id: mobile-c3d4
  #       claims:
  #         routes: { whitelist: ['ipb/v1/*'] }
  #   jwt:
  #     algorithm: RS256
  #     issuer: token-weaver
  #     ttl: 600

  # Custom login: an operator-supplied module decides the outcome (see examples/custom-login.mjs).
  # Token Weaver still signs the token, so jwt/encrypted_claims behave as usual.
  #   return claims (or { claims }) -> minted
  #   return null                   -> 401
  #   throw with numeric .status    -> that status (use the injected HttpError)
  #   throw anything else           -> 500, logged (never reported as bad credentials)
  #   exceed timeout_ms             -> 503
  # The module is imported at STARTUP, so a bad path or missing export fails the container.
  # - name: pictures
  #   type: custom
  #   handler: /app/custom/custom-login.mjs
  #   # handler_export: authenticate   # default: `default`, then `authenticate`
  #   timeout_ms: 5000
  #   options:                         # passed through, so the module stays environment-agnostic
  #     profileUrl: https://profiles.example.com/lookup
  #     tier: pictures
  #   # claims:                        # optional reshaping; handler result is at $.handler
  #   #   sub: $.handler.profile.id
  #   jwt:
  #     algorithm: RS256
  #     issuer: token-weaver
  #     ttl: 3600

